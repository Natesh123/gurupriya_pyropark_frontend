#!/usr/bin/expect -f
set timeout -1
set password "Prasath@1990"
set ip "103.191.208.98"

puts "Checking nginx..."
spawn ssh -o StrictHostKeyChecking=no root@$ip "cat /etc/nginx/sites-available/gurupriyapyropark.com || cat /etc/nginx/sites-available/default"
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
