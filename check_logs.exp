#!/usr/bin/expect -f
set timeout -1
set password "Prasath@1990"
set ip "103.191.208.98"

puts "Checking pm2 logs..."
spawn ssh -o StrictHostKeyChecking=no root@$ip "pm2 logs gurupriya_frontend --lines 15 --nostream"
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
